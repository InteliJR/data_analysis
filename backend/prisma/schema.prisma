generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTENTICAÇÃO E USUÁRIOS
// ============================================

enum UserRole {
  ADMIN
  COMERCIAL
  LOGISTICA
  IMPOSTO
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      UserRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdProducts       Product[]
  revokedTokens         RevokedToken[]
  
  rawMaterialChangeLogs RawMaterialChangeLog[] 

  @@map("users")
}

model RevokedToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
  @@index([userId])
  @@map("revoked_tokens")
}

// ============================================
// FRETE (TRANSPORTE)
// ============================================

enum Currency {
  BRL
  USD
  EUR
}

enum FreightOperationType {
  INTERNAL
  EXTERNAL
}

model Freight {
  id              String               @id @default(uuid())
  name            String
  description     String?              @db.Text
  unitPrice       Decimal              @db.Decimal(12, 2)
  currency        Currency             @default(BRL)
  originUf        String
  originCity      String
  destinationUf   String
  destinationCity String
  cargoType       String
  operationType   FreightOperationType
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  freightTaxes FreightTax[]
  // Mantido para compatibilidade, será substituído por relação via localidade
  rawMaterials RawMaterial[]

  // NOVO: relação de frete com localidades de matéria-prima
  rawMaterialLocations RawMaterialLocation[]

  products     Product[]

  @@map("freights")
}

model FreightTax {
  id        String   @id @default(uuid())
  name      String   @unique
  rate      Decimal  @db.Decimal(5, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  freights Freight[]

  @@map("freight_taxes")
}

// ============================================
// MATÉRIAS-PRIMAS
// ============================================

enum MeasurementUnit {
  KG
  G
  L
  ML
  M
  CM
  UN
  CX
  PC
}

model RawMaterial {
  id                String          @id @default(uuid())
  code              String          @unique
  name              String
  description       String?         @db.Text
  measurementUnit   MeasurementUnit
  inputGroup        String?
  paymentTerm       Int
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  productRawMaterials ProductRawMaterial[]
  changeLogs          RawMaterialChangeLog[]

  // NOVO: localidades com preços/impostos/fretes específicos
  locations           RawMaterialLocation[]

  // Compatibilidade: manter relação direta com fretes para não quebrar validações existentes
  freights            Freight[]

  // Compatibilidade: manter relação direta com impostos (global) para não quebrar validações existentes
  rawMaterialTaxes    RawMaterialTax[]

  @@index([code])
  @@index([name])
  @@map("raw_materials")
}

// ============================================
// NOVO: LOCALIDADES DE MATÉRIAS-PRIMAS
// Cada localidade possui preços, moeda, custo adicional,
// e relações específicas com fretes e impostos
// ============================================

model RawMaterialLocation {
  id                String     @id @default(uuid())
  rawMaterialId     String
  country           String?    @default("BR")
  stateUf           String
  city              String

  acquisitionPrice  Decimal    @db.Decimal(12, 2)
  currency          Currency   @default(BRL)
  priceConvertedBrl Decimal    @db.Decimal(12, 2)
  additionalCost    Decimal    @default(0) @db.Decimal(12, 2)

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)

  // Impostos específicos por localidade (com taxa/recuperável por localidade)
  locationTaxes RawMaterialLocationTax[]

  // Fretes aplicáveis à localidade
  freights Freight[]

  @@index([rawMaterialId])
  @@index([stateUf, city])
  @@map("raw_material_locations")
}

// Pivot com metadados por localidade e imposto (taxa/recuperável)
model RawMaterialLocationTax {
  id                    String   @id @default(uuid())
  rawMaterialLocationId String
  taxId                 String
  rate                  Decimal  @db.Decimal(5, 2)
  recoverable           Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  rawMaterialLocation RawMaterialLocation @relation(fields: [rawMaterialLocationId], references: [id], onDelete: Cascade)
  tax                RawMaterialTax       @relation(fields: [taxId], references: [id], onDelete: Restrict)

  @@unique([rawMaterialLocationId, taxId])
  @@index([rawMaterialLocationId])
  @@index([taxId])
  @@map("raw_material_location_taxes")
}

model RawMaterialChangeLog {
  id            String   @id @default(uuid())
  rawMaterialId String
  field         String
  oldValue      String?
  newValue      String?
  
  userId        String   
  changedAt     DateTime @default(now())

  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([rawMaterialId])
  @@index([userId])       
  @@index([changedAt])
  @@map("raw_material_change_logs")
}

model RawMaterialTax {
  id          String   @id @default(uuid())
  name        String   @unique
  rate        Decimal  @db.Decimal(5, 2)
  recoverable Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Compatibilidade com relação antiga
  rawMaterials RawMaterial[]

  // NOVO: relação com impostos por localidade (pivot)
  locationTaxes RawMaterialLocationTax[]

  @@map("raw_material_taxes")
}

// ============================================
// PRODUTOS E GRUPOS
// ============================================

model ProductGroup {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?  @db.Text
  porcentage Int? @db.Integer
  volumevendasconsiderar Int? @db.Integer
  overheadPerUnit       Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([name])
  @@map("product_groups")
}

model Product {
  id                          String   @id @default(uuid())
  code                        String   @unique
  name                        String
  description                 String?  @db.Text
  creatorId                   String
  priceWithoutTaxesAndFreight Decimal? @db.Decimal(12, 2)
  priceWithTaxesAndFreight    Decimal? @db.Decimal(12, 2)
  fixedCostId                 String?
  productGroupId              String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  creator             User                @relation(fields: [creatorId], references: [id])
  fixedCost           FixedCost?          @relation(fields: [fixedCostId], references: [id], onDelete: SetNull)
  productGroup        ProductGroup?       @relation(fields: [productGroupId], references: [id], onDelete: SetNull)
  productRawMaterials ProductRawMaterial[]
  
  freights            Freight[]

  @@index([code])
  @@index([name])
  @@index([fixedCostId])
  @@index([productGroupId])
  @@map("products")
}

model ProductRawMaterial {
  productId     String
  rawMaterialId String
  quantity      Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)

  @@id([productId, rawMaterialId])
  @@map("product_raw_materials")
}

// ============================================
// CUSTOS FIXOS
// ============================================

model FixedCost {
  id                      String   @id @default(uuid())
  description             String
  code                    String?  @unique
  personnelExpenses       Decimal  @db.Decimal(12, 2)
  generalExpenses         Decimal  @db.Decimal(12, 2)
  proLabore               Decimal  @db.Decimal(12, 2)
  depreciation            Decimal  @default(0) @db.Decimal(12, 2)
  totalCost               Decimal  @db.Decimal(12, 2)
  considerationPercentage Decimal  @default(100) @db.Decimal(5, 2)
  calculationDate         DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  products Product[]

  @@index([calculationDate])
  @@map("fixed_costs")
}