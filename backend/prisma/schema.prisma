generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTENTICAÇÃO E USUÁRIOS
// ============================================

enum UserRole {
  ADMIN
  COMERCIAL
  LOGISTICA
  IMPOSTO
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      UserRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdProducts       Product[]
  revokedTokens         RevokedToken[]
  rawMaterialChangeLogs RawMaterialChangeLog[]
  locationChangeLogs   LocationChangeLog[]

  @@map("users")
}

model RevokedToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
  @@index([userId])
  @@map("revoked_tokens")
}

// ============================================
// LOCATIONS (NOVO: Entidade Mestre de Unidades)
// ============================================
// Cadastra-se as unidades aqui (Ex: "Matriz SP", "Filial SC")
// Para serem reutilizadas por várias matérias-primas.

model Location {
  id        String   @id @default(uuid())
  name      String   // Ex: "Armazém Principal", "Porto de Santos"
  country   String?  @default("BR")
  stateUf   String
  city      String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relação N:N com matérias-primas
  rawMaterials RawMaterialLocationPivot[]

  changeLogs LocationChangeLog[]

  @@map("locations")
}

model LocationChangeLog {
  id         String   @id @default(uuid())
  locationId String
  field      String
  oldValue   String?
  newValue   String?
  userId     String
  changedAt  DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([locationId])
  @@index([userId])
  @@index([changedAt])
  @@map("location_change_logs")
}

// ============================================
// FRETE (TRANSPORTE)
// ============================================

enum Currency {
  BRL
  USD
  EUR
}

enum FreightOperationType {
  INTERNAL
  EXTERNAL
}

model Freight {
  id              String               @id @default(uuid())
  name            String
  description     String?              @db.Text
  unitPrice       Decimal              @db.Decimal(12, 2)
  currency        Currency             @default(BRL)
  originUf        String
  originCity      String
  destinationUf   String
  destinationCity String
  cargoType       String
  operationType   FreightOperationType
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  freightTaxes FreightTax[]

  // ATUALIZADO: Frete agora se relaciona com a associação MP-Localização
  // Isso permite calcular o frete específico para trazer aquela MP para aquela Unidade
  rawMaterialLocations RawMaterialLocationPivot[]

  products Product[]

  @@map("freights")
}

model FreightTax {
  id        String   @id @default(uuid())
  name      String   @unique
  rate      Decimal  @db.Decimal(5, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  freights Freight[]

  @@map("freight_taxes")
}

// ============================================
// MATÉRIAS-PRIMAS
// ============================================

enum MeasurementUnit {
  KG
  G
  L
  ML
  M
  CM
  UN
  CX
  PC
}

model RawMaterial {
  id              String          @id @default(uuid())
  code            String          @unique
  name            String
  description     String?         @db.Text
  measurementUnit MeasurementUnit
  inputGroup      String?
  paymentTerm     Int
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  productRawMaterials ProductRawMaterial[]
  changeLogs          RawMaterialChangeLog[]

  // ATUALIZADO: Relação via tabela Pivot (N:N) com Locations
  locations           RawMaterialLocationPivot[]

  // OBS: Removi a relação direta com 'Freight' e 'RawMaterialTax' pois 
  // o usuário especificou que isso depende da localização/aquisição.

  @@index([code])
  @@index([name])
  @@map("raw_materials")
}

// ============================================
// PIVOT: MATÉRIA-PRIMA <-> LOCALIZAÇÃO
// ============================================
// Esta é a tabela intermediária N:N que segura os PREÇOS.
// Uma MP (Aço) na Location (SP) custa X.
// Uma MP (Aço) na Location (MG) custa Y.

model RawMaterialLocationPivot {
  id             String   @id @default(uuid())
  
  rawMaterialId  String
  locationId     String   // Referência à nova tabela Location

  // PREÇOS E CUSTOS (Específicos desta relação)
  acquisitionPrice  Decimal  @db.Decimal(12, 2)
  currency          Currency @default(BRL)
  priceConvertedBrl Decimal? @db.Decimal(12, 2)
  additionalCost    Decimal  @default(0) @db.Decimal(12, 2)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  location    Location    @relation(fields: [locationId], references: [id], onDelete: Restrict)

  // Impostos específicos desta aquisição (MP nesta Localidade)
  locationTaxes RawMaterialLocationTax[]

  // Fretes aplicáveis para levar esta MP para esta Localidade
  freights Freight[]

  @@unique([rawMaterialId, locationId]) // Impede duplicar a mesma MP na mesma Location
  @@index([rawMaterialId])
  @@index([locationId])
  @@map("raw_material_location_pivots")
}

// Pivot de Impostos sobre a relação MP-Localização
model RawMaterialLocationTax {
  id                        String   @id @default(uuid())
  rawMaterialLocationPivotId String
  taxId                     String
  
  rate                      Decimal  @db.Decimal(5, 2)
  recoverable               Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  // Aponta para a Pivot acima
  rawMaterialLocationPivot RawMaterialLocationPivot @relation(fields: [rawMaterialLocationPivotId], references: [id], onDelete: Cascade)
  tax                      RawMaterialTax           @relation(fields: [taxId], references: [id], onDelete: Restrict)

  @@unique([rawMaterialLocationPivotId, taxId])
  @@index([rawMaterialLocationPivotId])
  @@index([taxId])
  @@map("raw_material_location_taxes")
}

model RawMaterialChangeLog {
  id            String   @id @default(uuid())
  rawMaterialId String
  field         String
  oldValue      String?
  newValue      String?
  
  userId        String    
  changedAt     DateTime @default(now())

  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([rawMaterialId])
  @@index([userId])        
  @@index([changedAt])
  @@map("raw_material_change_logs")
}

model RawMaterialTax {
  id          String   @id @default(uuid())
  name        String   @unique
  // A taxa padrão pode existir, mas a taxa real aplicada fica na pivot RawMaterialLocationTax
  defaultRate Decimal  @db.Decimal(5, 2) 
  recoverable Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Apenas relação com a pivot de impostos
  locationTaxes RawMaterialLocationTax[]

  @@map("raw_material_taxes")
}

// ============================================
// PRODUTOS E GRUPOS
// ============================================

model ProductGroup {
  id                     String   @id @default(uuid())
  name                   String   @unique
  description            String?  @db.Text
  porcentage             Int?     @db.Integer
  volumevendasconsiderar Int?     @db.Integer
  overheadPerUnit        Decimal? @db.Decimal(12, 2)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  products Product[]

  @@index([name])
  @@map("product_groups")
}

model Product {
  id                          String   @id @default(uuid())
  code                        String   @unique
  name                        String
  description                 String?  @db.Text
  creatorId                   String
  
  // PREÇIFICAÇÃO
  // Nota: A lógica de cálculo deve somar: 
  // (Custo MP * Qtd) + (Frete MP * Qtd) + (Impostos MP não recuperáveis) + Frete Produto + Custos Fixos
  
  priceWithoutTaxesAndFreight Decimal? @db.Decimal(12, 2)
  
  // Renomeei/Comentei para deixar claro que isso é o custo final total calculado
  // Deve incluir o frete das matérias-primas (vinda da relation Product -> RawMaterial -> Pivot -> Freight)
  totalCostWithAllFreights    Decimal? @db.Decimal(12, 2) 

  fixedCostId                 String?
  productGroupId              String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  creator          User               @relation(fields: [creatorId], references: [id])
  fixedCost        FixedCost?         @relation(fields: [fixedCostId], references: [id], onDelete: SetNull)
  productGroup     ProductGroup?      @relation(fields: [productGroupId], references: [id], onDelete: SetNull)
  
  productRawMaterials ProductRawMaterial[]
  
  // Fretes de SAÍDA do produto (Entrega ao cliente/CD)
  freights            Freight[]

  @@index([code])
  @@index([name])
  @@index([fixedCostId])
  @@index([productGroupId])
  @@map("products")
}

model ProductRawMaterial {
  productId     String
  rawMaterialId String
  quantity      Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)

  @@id([productId, rawMaterialId])
  @@map("product_raw_materials")
}

// ============================================
// CUSTOS FIXOS
// ============================================

model FixedCost {
  id                      String   @id @default(uuid())
  description             String
  code                    String?  @unique
  personnelExpenses       Decimal  @db.Decimal(12, 2)
  generalExpenses         Decimal  @db.Decimal(12, 2)
  proLabore               Decimal  @db.Decimal(12, 2)
  depreciation            Decimal  @default(0) @db.Decimal(12, 2)
  totalCost               Decimal  @db.Decimal(12, 2)
  considerationPercentage Decimal  @default(100) @db.Decimal(5, 2)
  calculationDate         DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  products Product[]

  @@index([calculationDate])
  @@map("fixed_costs")
}